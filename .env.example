# Agent Bus local configuration.
# Copy to .env or export these in your shell if you want custom paths.

# Runtime mailbox. Keep this outside synced/cloud folders when possible.
AGENT_BUS_ROOT=~/AgentBus

# Optional web control plane settings. The service rejects non-localhost binds.
AGENT_BUS_HOST=127.0.0.1
AGENT_BUS_PORT=8091
# AGENT_BUS_BASE_PATH=/agent-bus
# AGENT_BUS_LOG_DIR=~/var/log/home-platform/agent-bus
# AGENT_BUS_WRITE_TOKEN=use-1password-at-runtime-if-enabled

# Optional read-only Knowledge Vault model selector v3 directory.
# The dashboard remains usable and reports selector unavailable when omitted.
# AGENT_BUS_SELECTOR_PATH=/srv/kv/vault/it-setup/llm-selector/v3

# Local MCP servers can use the A6-hosted ledger instead of creating a second local ledger.
# AGENT_BUS_CONTROL_PLANE_URL=http://127.0.0.1:18091/agent-bus

# Optional: project root used by the Codex bridge.
# Defaults to this repository root when omitted.
# AGENT_BUS_PROJECT_ROOT=/path/to/agent-bus

# Optional Codex bridge settings. The bridge ignores normal user MCP/plugin config by
# default so an unrelated OAuth failure cannot break unattended work. Set this to 0 only
# when the bridge deliberately needs the normal Codex configuration.
AGENT_BUS_CODEX_MODEL=gpt-5.6-sol
AGENT_BUS_CODEX_SANDBOX=workspace-write
AGENT_BUS_CODEX_POLL_MS=2000
# AGENT_BUS_CODEX_IGNORE_USER_CONFIG=1
# AGENT_BUS_CODEX_SESSION_STORE=~/Library/Application Support/Agent Bus/codex/sessions.json

# Optional Cursor bridge settings.
AGENT_BUS_CURSOR_MODEL=cursor-grok-4.5-high
AGENT_BUS_CURSOR_SANDBOX=enabled
AGENT_BUS_CURSOR_POLL_MS=2000
# AGENT_BUS_CURSOR_WORKSPACE=~
# AGENT_BUS_CURSOR_STATE_DIR=~/Library/Application Support/Agent Bus/cursor

# Optional Antigravity bridge settings.
AGENT_BUS_ANTIGRAVITY_MODEL="Gemini 3.5 Flash (Medium)"
AGENT_BUS_ANTIGRAVITY_POLL_MS=2000
# AGENT_BUS_ANTIGRAVITY_WORKSPACE=~
# AGENT_BUS_ANTIGRAVITY_STATE_DIR=~/Library/Application Support/Agent Bus/antigravity
AGENT_BUS_WRITE_TOKEN=replace-with-a-generated-random-token
