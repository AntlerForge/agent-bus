# Agent Bus local configuration.
# Copy to .env or export these in your shell if you want custom paths.

# Runtime mailbox. Keep this outside synced/cloud folders when possible.
AGENT_BUS_ROOT=~/AgentBus

# Optional: project root used by the Codex bridge.
# Defaults to this repository root when omitted.
# AGENT_BUS_PROJECT_ROOT=/path/to/agent-bus

# Optional Codex bridge settings.
AGENT_BUS_CODEX_MODEL=gpt-5.2
AGENT_BUS_CODEX_SANDBOX=workspace-write
AGENT_BUS_CODEX_POLL_MS=2000
