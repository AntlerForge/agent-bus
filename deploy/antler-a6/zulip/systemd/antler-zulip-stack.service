[Unit]
Description=AntlerForge Zulip stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/projects/Personal/agent-bus/app/deploy/antler-a6/zulip
ExecStartPre=/usr/bin/test -x /usr/bin/op
ExecStartPre=/usr/bin/test -r /etc/zulip-estate/op.env
ExecStartPre=/usr/bin/test -r /etc/1password/service-accounts/zulip-antlerforge.token
ExecStart=/usr/local/libexec/antler-zulip-op-run /usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=20min
TimeoutStopSec=5min

[Install]
WantedBy=antler-zulip.target
