[Unit]
Description=Antler Zulip phase-1 trial stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/projects/Personal/agent-bus/app/deploy/antler-a6/zulip
ExecStartPre=/usr/bin/test -x /usr/local/bin/op
ExecStartPre=/usr/bin/test -r /etc/zulip-estate/op.env
ExecStart=/usr/local/bin/op run --env-file=/etc/zulip-estate/op.env -- /usr/bin/docker compose up -d --wait
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=20min
TimeoutStopSec=5min

[Install]
WantedBy=antler-zulip.target
