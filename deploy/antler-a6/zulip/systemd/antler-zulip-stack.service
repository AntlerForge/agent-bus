[Unit]
Description=AntlerForge Zulip stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/projects/Personal/agent-bus/app/deploy/antler-a6/zulip
ExecStartPre=/usr/local/libexec/antler-zulip-check-secrets
ExecStart=/usr/local/libexec/antler-zulip-start
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=20min
TimeoutStopSec=5min

[Install]
WantedBy=antler-zulip.target
