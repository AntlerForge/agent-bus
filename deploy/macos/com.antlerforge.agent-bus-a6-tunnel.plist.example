<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.antlerforge.agent-bus-a6-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string><string>-N</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-L</string><string>127.0.0.1:18091:127.0.0.1:8091</string>
    <string>USER@A6-HOST</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- LaunchAgents inherit a 256-fd soft limit; ssh accepts one fd per forwarded
       connection, so heavy bridge polling exhausts it ("accept: Too many open
       files" then exit 255). Give the tunnel real headroom. -->
  <key>SoftResourceLimits</key><dict><key>NumberOfFiles</key><integer>4096</integer></dict>
  <key>HardResourceLimits</key><dict><key>NumberOfFiles</key><integer>8192</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOU/var/log/home-platform/agent-bus/a6-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/var/log/home-platform/agent-bus/a6-tunnel.err.log</string>
</dict>
</plist>
