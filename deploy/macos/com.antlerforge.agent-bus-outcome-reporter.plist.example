<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.antlerforge.agent-bus-outcome-reporter</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>/Users/antonybarfoot/Developer/personal/agent-bus/scripts/outcome-truth-mac-report.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>/Users/antonybarfoot/Library/Logs/Agent Bus/outcome-reporter.log</string>
  <key>StandardErrorPath</key><string>/Users/antonybarfoot/Library/Logs/Agent Bus/outcome-reporter.error.log</string>
</dict></plist>
