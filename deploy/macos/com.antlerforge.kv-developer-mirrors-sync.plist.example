<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.antlerforge.kv-developer-mirrors-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/antonybarfoot/Developer/personal/agent-bus/scripts/outcome-truth-launchagent-wrapper.sh</string>
		<string>kv-developer-mirrors-sync</string>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>cd /Users/antonybarfoot/Developer/personal/knowledge-vault &amp;&amp; ./ops/antler-a6/sync-developer-mirrors.sh --apply</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/antonybarfoot/Library/Logs/AntlerForge/kv-developer-mirrors-sync.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/antonybarfoot/Library/Logs/AntlerForge/kv-developer-mirrors-sync.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
		<dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/antonybarfoot/Developer/personal/knowledge-vault</string>
</dict>
</plist>
