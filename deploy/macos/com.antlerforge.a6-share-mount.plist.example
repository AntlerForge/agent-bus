<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.antlerforge.a6-share-mount</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/antonybarfoot/Developer/personal/agent-bus/scripts/outcome-truth-launchagent-wrapper.sh</string>
		<string>a6-share-mount</string>
		<string>/Users/antonybarfoot/Developer/personal/knowledge-vault/scripts/mount-antler-a6-share.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/antonybarfoot/Library/Logs/AntlerForge/a6-share-mount.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/antonybarfoot/Library/Logs/AntlerForge/a6-share-mount.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>5</integer></dict>
		<dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>5</integer></dict>
	</array>
</dict>
</plist>
