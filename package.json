{
  "name": "agent-bus",
  "version": "1.0.0",
  "description": "Local-first mailbox and bridge for agent-to-agent messaging between Claude, Codex, and other LLM agents.",
  "type": "module",
  "main": "src/server.mjs",
  "bin": {
    "agent-bus": "src/server.mjs",
    "agent-bus-antigravity-bridge": "src/antigravity-bridge.mjs",
    "agent-bus-channel": "src/claude-channel.mjs",
    "agent-bus-codex-bridge": "src/codex-bridge.mjs",
    "agent-bus-cursor-bridge": "src/cursor-bridge.mjs",
    "agent-bus-dashboard": "src/control-plane/server.mjs",
    "agent-bus-selector-check": "src/model-selector-check.mjs"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "setup": "./setup.sh",
    "dashboard": "node src/control-plane/server.mjs",
    "bridge:test": "node scripts/bridge-roundtrip.mjs",
    "selector:check": "node src/model-selector-check.mjs",
    "state:lint": "node src/state-lint.mjs",
    "ha:notify": "node scripts/ha-notify-tony.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntlerForge/agent-bus.git"
  },
  "keywords": [
    "mcp",
    "agents",
    "claude",
    "codex",
    "local-first",
    "markdown",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AntlerForge/agent-bus/issues"
  },
  "homepage": "https://github.com/AntlerForge/agent-bus#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
